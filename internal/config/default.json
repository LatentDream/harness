{
  "userConfigPath": "~/.harness.json",
  "logging": {
    "development": true,
    "level": "debug",
    "encoding": "json",
    "output": "file",
    "filePath": "~/.harness/logs/{sessionId}/{sessionId}.log",
    "disableCaller": false,
    "disableStacktrace": false
  },
  "providers": [
    {
      "name": "codex",
      "type": "codex",
      "auth_file": "~/.local/share/opencode/auth.json",
      "auth_provider": "openai",
      "models": [{ "name": "gpt-5.5" }],
      "enabled": true
    }

  ]
}

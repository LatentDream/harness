{
  "userConfigPath": "~/.harness.json",
  "logging": {
    "development": false,
    "level": "info",
    "encoding": "json",
    "output": "stdout",
    "disableCaller": false,
    "disableStacktrace": false
  },
  "providers": [
    {
      "name": "codex",
      "type": "codex",
      "auth_file": "~/.local/share/opencode/auth.json",
      "auth_provider": "openai",
      "models": [{ "name": "gpt-5.5" }],
      "enabled": true
    }

  ]
}
